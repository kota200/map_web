{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rna-seq-local.invalid/contracts/analysis-job.schema.json",
  "title": "RNA-seq analysis job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "mode", "engine", "samples", "reference", "options", "privacy"],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["web", "desktop"] },
    "engine": { "enum": ["kallisto", "hisat2-featurecounts"] },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./sample.schema.json" }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["transcriptome-fasta", "kallisto-index", "hosted-hisat2-index", "local-hisat2-index"]
        },
        "id": { "type": "string" },
        "basename": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assembly": { "type": "string" },
        "annotation_version": { "type": "string" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threads", "arguments"],
      "properties": {
        "threads": { "type": "integer", "minimum": 1 },
        "stages": {
          "type": "array",
          "items": { "enum": ["fastp", "kallisto", "hisat2", "featureCounts", "tpm"] }
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "resource_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputBytes", "referenceBytes", "temporaryBytes", "requiredStorageBytes", "supported", "recommendDesktop", "warnings", "errors"],
          "properties": {
            "inputBytes": { "type": "number", "minimum": 0 },
            "referenceBytes": { "type": "number", "minimum": 0 },
            "gzip": { "type": "boolean" },
            "decompressedFastqBytes": { "type": "number", "minimum": 0 },
            "cleanedFastqBytes": { "type": "number", "minimum": 0 },
            "samBytes": { "type": "number", "minimum": 0 },
            "temporaryBytes": { "type": "number", "minimum": 0 },
            "requiredStorageBytes": { "type": "number", "minimum": 0 },
            "availableBytes": { "type": ["number", "null"], "minimum": 0 },
            "supported": { "type": "boolean" },
            "recommendDesktop": { "type": "boolean" },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "errors": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_input_processing", "uploads_biological_data"],
      "properties": {
        "local_input_processing": { "const": true },
        "uploads_biological_data": { "const": false },
        "network_purposes": {
          "type": "array",
          "items": { "enum": ["static-app", "wasm-runtime", "hosted-reference", "hosted-annotation"] }
        }
      }
    }
  }
}
