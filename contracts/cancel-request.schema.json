{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rna-seq-local.invalid/contracts/cancel-request.schema.json",
  "title": "RNA-seq cancellation request and acknowledgement",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "job_id", "requested_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "cancel-request" },
        "job_id": { "type": "string", "minLength": 1 },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "job_id", "status", "cleanup"],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "cancel-ack" },
        "job_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["cancelled", "already-finished", "not-found", "failed"] },
        "cleanup": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["completed", "partial", "not-required", "failed"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  ]
}
