{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kallisto-web:index-catalog-schema:v1",
  "title": "Hosted HISAT2 index catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "references"],
  "properties": {
    "schema_version": { "const": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "size", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "url": { "type": "string", "format": "uri-reference" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "length"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "url", "size", "sha256", "format", "version",
        "default_feature_type", "default_grouping_attribute", "contigs"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "url": { "type": "string", "format": "uri-reference" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "format": { "enum": ["GTF", "GFF3"] },
        "version": { "type": "string", "minLength": 1 },
        "default_feature_type": { "type": "string", "minLength": 1 },
        "default_grouping_attribute": { "type": "string", "minLength": 1 },
        "contigs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "organism", "assembly", "hisat2_version", "index_format",
        "build_arguments", "files", "annotation", "contigs", "source_urls", "licenses", "created_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "display_name": { "type": "string", "minLength": 1 },
        "organism": { "type": "string", "minLength": 1 },
        "assembly": { "type": "string", "minLength": 1 },
        "hisat2_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "index_format": { "enum": ["ht2", "ht2l"] },
        "build_arguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "files": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "annotation": { "$ref": "#/$defs/annotation" },
        "contigs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contig" }
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri-reference" }
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "test_only": { "type": "boolean" }
      }
    }
  }
}
